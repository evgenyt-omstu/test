WITH ts AS (
    SELECT now() AS ts
),
lock_ok AS (
    SELECT 1
    FROM object_lock ol, ts
    WHERE ol.global_id = :globalId
      AND ol.token     = :lockToken
      AND ol.expire    > ts.ts
),
prev AS (
    -- Берём активную запись (если есть) и блокируем её на время транзакции
    SELECT rem.id, rem.revision, rem.version
    FROM revisioned_entry_main rem
    WHERE rem.global_id = :globalId
      AND rem.closed_at = TIMESTAMP '3000-01-01 00:00:00'
      AND EXISTS (SELECT 1 FROM lock_ok)
    FOR UPDATE
),
closed AS (
    UPDATE revisioned_entry_main rem
       SET closed_at = ts.ts
      FROM ts
     WHERE rem.id IN (SELECT id FROM prev)
)
INSERT INTO revisioned_entry_main (
    object_class,
    global_id,
    revision,
    version,
    saved_at,
    closed_at
)
SELECT
    :objectClass,
    :globalId,
    COALESCE((SELECT revision FROM prev), 0) + 1,
    COALESCE((SELECT version  FROM prev), 0) + 1,
    ts.ts,
    TIMESTAMP '3000-01-01 00:00:00'
FROM ts
WHERE EXISTS (SELECT 1 FROM lock_ok)
RETURNING id, revision, version;
