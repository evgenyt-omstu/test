WITH src (id, number, content) AS (
  VALUES
    (1, 'A-001', '{"a":1}'),
    (2, 'A-002', '{"b":2}'),
    (3, 'A-003', '{"c":3}')
),
ins_index AS (
  INSERT INTO "index" (id, number)
  SELECT m.id, s.number
  FROM src s
  JOIN main m ON m.id = s.id
  ON CONFLICT (id) DO UPDATE
    SET number = EXCLUDED.number
  RETURNING id
)
INSERT INTO data (id, content)
SELECT i.id, s.content::jsonb
FROM ins_index i
JOIN src s USING (id)
ON CONFLICT (id) DO UPDATE
  SET content = EXCLUDED.content;
